{
  "name": "karantin",
  "version": "0.92.1",
  "private": true,
  "description": "Dead Line — мобильная зомби-выживалка в браузере",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "site": "node build.mjs --site",
    "yandex": "node build.mjs --yandex",
    "android": "node build.mjs --android",
    "deploy": "node build.mjs --site && sh tools/deploy.sh",
    "appicon": "node tools/icons/appicon.mjs pwa",
    "dev": "node serve.mjs",
    "test": "node build.mjs --dev && node tests/run.mjs",
    "icons": "python3 tools/icons/gen.py assets/sprites/icons.png assets/icons.json",
    "golden": "node build.mjs --dev && node tests/golden.mjs",
    "golden:save": "node build.mjs --dev && node tests/golden.mjs save"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "playwright": "1.56.0"
  }
}
